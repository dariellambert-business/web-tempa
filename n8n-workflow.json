      "id": "notion-node",
      "name": "Notion — Simpan Request",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [480, 300],
      "credentials": {
        "notionApi": {
          "id": "GANTI_NOTION_CREDENTIAL_ID",
          "name": "Notion — Web Tempa"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.callmebot.com/whatsapp.php?phone=0895806680374&text={{ encodeURIComponent('🔔 *ORDER BARU — Web Tempa*%0A%0ANama: ' + $('Webhook').item.json.body.nama_bisnis + '%0AKontak: ' + $('Webhook').item.json.body.kontak + '%0ABudget: ' + $('Webhook').item.json.body.budget + '%0ADeadline: ' + ($('Webhook').item.json.body.deadline || '-') + '%0ARush: ' + ($('Webhook').item.json.body.rush_project ? 'YA ⚡' : 'Tidak') + '%0A%0A✅ Data sudah tersimpan di Notion.') }}&apikey=GANTI_CALLMEBOT_APIKEY",
        "options": {}
      },
      "id": "wa-node",
      "name": "WhatsApp Notif",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"message\": \"Data berhasil diterima\" }",
        "options": {}
      },
      "id": "response-node",
      "name": "Response ke Form",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 460]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          { "node": "Notion — Simpan Request", "type": "main", "index": 0 }
        ]
